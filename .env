# Supabase 连接参数。
#
# 这两个值是故意提交进仓库的 —— 它们本来就会被打包进前端 JS，
# 谁打开网页都看得到，这是 Supabase 的设计。真正拦人的是数据库里的
# RLS 规则，不是把这两个字符串藏起来。
#
# 换句话说：这里不是放密码的地方。
# service_role / secret 那一类的 key 一个都不许进这个文件。
VITE_SUPABASE_URL=https://tggmzjyhgayiwpubtdvu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GqmTeFCJrefcgn7i2f_UXQ_2Jq7yo1r

# 推送（VAPID）的公钥。私钥不在这里，也不该在这里 ——
# 它只放在 Supabase 的 Edge Function Secrets 里。
VITE_VAPID_PUBLIC_KEY=BFp4ygnNL9hTIxo-LovN8gCT6YIAR0tTRN5MdI5VH6vBLLFF96sBpnoKHs6z0x6-fAWPBO_DdXyalkx0wRanftk
